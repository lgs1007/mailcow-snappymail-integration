+
+	/*
+	 * mailcow integration modification:
+	 * Dovecot master credentials are rotated by mailcow and exposed to this
+	 * container through a read-only bind mount. Read the current value for each
+	 * ProxyAuth login. If the file is unavailable or malformed, retain the
+	 * upstream plugin's configured static credentials as a fallback.
+	 */
+	private const MAILCOW_MASTER_CREDS_FILE = '/run/secrets/mailcow-sieve-creds';
+	private static string $mailcowMasterUser = '';
+
+	private function GetMasterCredentials() : array
+	{
+		$sMasterUser = \trim($this->Config()->getDecrypted('plugin', 'master_user', ''));
+		$sMasterPassword = \trim($this->Config()->getDecrypted('plugin', 'master_password', ''));
+
+		$sRaw = @\file_get_contents(self::MAILCOW_MASTER_CREDS_FILE);
+		if (\is_string($sRaw)) {
+			$sRaw = \trim($sRaw);
+			$iSeparator = \strpos($sRaw, ':');
+			if (false !== $iSeparator) {
+				$sDynamicUser = \trim(\substr($sRaw, 0, $iSeparator));
+				$sDynamicPassword = \substr($sRaw, $iSeparator + 1);
+				if ('' !== $sDynamicUser && '' !== $sDynamicPassword) {
+					return [$sDynamicUser, $sDynamicPassword];
+				}
+			}
+		}
+
+		return [$sMasterUser, $sMasterPassword];
+	}
+
